   "id": "n_d",
   "x": 830,
   "y": 392,
   "width": 217.8,
   "height": 27.5,
   "fontSize": 11,
   "fontFamily": 5,
   "text": "4. Telefono pasa a WhatsApp.\n   Es el canal real de este publico.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "4. Telefono pasa a WhatsApp.\n   Es el canal real de este publico.",
