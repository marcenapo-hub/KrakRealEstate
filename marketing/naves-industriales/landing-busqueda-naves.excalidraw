   "lineHeight": 1.25,
   "strokeColor": "#4E586E",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
