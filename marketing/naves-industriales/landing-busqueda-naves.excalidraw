  },
  {
   "type": "text",
   "id": "n_b",
   "x": 830,
   "y": 252,
   "width": 235.95000000000002,
   "height": 55.0,
   "fontSize": 11,
   "fontFamily": 5,
   "text": "2. El 4to select pasa de Operacion\n   a CUANDO LA NECESITAS. La operacion\n   ya es alquiler; el timing es el dato\n   que ordena el pipeline.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "2. El 4to select pasa de Operacion\n   a CUANDO LA NECESITAS. La operacion\n   ya es alquiler; el timing es el dato\n   que ordena el pipeline.",
   "autoResize": true,
   "lineHeight": 1.25,
   "strokeColor": "#4E586E",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
