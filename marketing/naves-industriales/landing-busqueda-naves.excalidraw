  {
   "type": "text",
   "id": "n_a",
   "x": 830,
   "y": 192,
   "width": 217.8,
   "height": 41.25,
   "fontSize": 11,
   "fontFamily": 5,
   "text": "1. Tira de prueba arriba del fold.\n   El que busca necesita ver que hay\n   naves antes de llenar nada.",
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "1. Tira de prueba arriba del fold.\n   El que busca necesita ver que hay\n   naves antes de llenar nada.",
   "autoResize": true,
   "lineHeight": 1.25,
   "strokeColor": "#4E586E",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
